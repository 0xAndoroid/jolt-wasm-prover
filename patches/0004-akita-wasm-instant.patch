 use std::mem;
-use std::time::Instant;
+use crate::wasm_instant::Instant;
 
 use crate::backend::packed_digits::{
     PackedSignedDigitIter, PackedSignedDigitView, PackedSignedDigits,
diff --git a/crates/akita-prover/src/wasm_instant.rs b/crates/akita-prover/src/wasm_instant.rs
new file mode 100644
index 0000000..d75b908
--- /dev/null
+++ b/crates/akita-prover/src/wasm_instant.rs
@@ -0,0 +1,21 @@
+//! `std::time::Instant` has no clock on `wasm32-unknown-unknown` (`now()`
+//! panics). The prover only reads it for diagnostics, so the wasm32 build
+//! swaps in a zero-duration stand-in and keeps the timing code paths intact.
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) use std::time::Instant;
+
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Instant;
+
+#[cfg(target_arch = "wasm32")]
+impl Instant {
+    pub(crate) fn now() -> Self {
