diff --git a/crates/akita-prover/src/protocol/sumcheck/relation_range_image/mod.rs b/crates/akita-prover/src/protocol/sumcheck/relation_range_image/mod.rs
index 1f48294..ea1e424 100644
--- a/crates/akita-prover/src/protocol/sumcheck/relation_range_image/mod.rs
+++ b/crates/akita-prover/src/protocol/sumcheck/relation_range_image/mod.rs
@@ -97,7 +97,7 @@ use jolt_field::solinas::parallel::*;
 use jolt_field::{Field, Ring, Zero};
