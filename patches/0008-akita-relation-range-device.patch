+    /// Add the structured linear term of every live flat address
+    /// (`lane * coeff_count + coefficient`) into `out`.
+    pub(crate) fn add_flat_into(&self, out: &mut [E]) {
+        let coeff_count = self.coeff_count;
+        let live = &mut out[..self.live_lane_count * coeff_count];
+        cfg_chunks_mut!(live, coeff_count)
+            .enumerate()
+            .for_each(|(lane, row)| {
+                self.resolve_lane(lane).for_each_factored(|factor, values| {
+                    for (slot, value) in row.iter_mut().zip(values) {
+                        *slot += factor * *value;
+                    }
+                });
+            });
+    }
+
+    /// Per-lane linear segments for the device: `lane_map[lane] = start << 8 |
+    /// count` into the returned segments `([source_lane, source_index, 0, 0],
+    /// factor)`; `None` for the dense lane kind, more than 255 terms on one
+    /// lane or more than `max` segments.
+    pub(crate) fn export_lane_segments(
+        &self,
+        max: usize,
+    ) -> Option<(Vec<u32>, Vec<([u32; 4], E)>)> {
+        let mut lane_map = vec![0u32; self.live_lane_count];
+        let mut out: Vec<([u32; 4], E)> = Vec::new();
+        match &self.lane_weights {
+            PreparedLaneWeights::Dense(_) => return None,
+            PreparedLaneWeights::Packing(packing) => {
+                for (lane, slot) in lane_map.iter_mut().enumerate() {
+                    let Some(segment) = packing
+                        .lane_to_segment
+                        .get(lane)
+                        .and_then(|s| *s)
+                        .and_then(|s| packing.segments.get(s.get() - 1))
+                    else {
+                        continue;
+                    };
+                    let offset = lane.checked_sub(segment.target_lane_start)?;
+                    if offset >= segment.lane_count {
+                        continue;
+                    }
+                    *slot = ((out.len() as u32) << 8) | 1;
+                    out.push((
+                        [
+                            (segment.source_lane_start + offset) as u32,
+                            segment.source_index as u32,
+                            0,
+                            0,
+                        ],
+                        segment.factor,
+                    ));
+                    if out.len() > max {
+                        return None;
+                    }
+                }
+            }
+            PreparedLaneWeights::Sparse(lanes) => {
+                for (lane, terms) in lanes.iter().enumerate() {
+                    if terms.is_empty() {
+                        continue;
+                    }
+                    if terms.len() > 255 {
+                        return None;
+                    }
+                    lane_map[lane] = ((out.len() as u32) << 8) | terms.len() as u32;
+                    for term in terms {
+                        out.push((
+                            [term.lane as u32, term.source_index as u32, 0, 0],
+                            term.factor,
+                        ));
+                    }
+                    if out.len() > max {
+                        return None;
+                    }
+                }
+            }
+        }
+        Some((lane_map, out))
+    }
