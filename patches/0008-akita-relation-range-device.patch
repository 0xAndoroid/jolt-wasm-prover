+++ b/crates/akita-prover/src/protocol/sumcheck/relation_range_image/device.rs
@@ -0,0 +1,193 @@
+//! Optional device seam for the stage-2 relation-range sumcheck rounds.
+//!
+//! A [`RelationRangeDevice`] may take the first rounds of one instance. It
+//! receives the compact digit witness once plus the relation weights either
+//! as one flat table (`Dense`: dense weights + every linear term per padded
+//! address) or factored (`Factored`: lane weights on the device, the common
+//! alpha factor and the packing/sparse linear sources folded by the host and
+//! passed per round with their lane segments). Per round it gets the
+//! previous challenge, the prover's remaining Gruen eq tables and the sparse
+//! additional pairs, and returns the ten round terms: norm `q0,q1,q2`
+//! (eq-weighted), relation `c0,c1,c2`, additional cubic `a0..a3`. After its
+//! last round it hands the folded witness (and the folded flat weights once
+//! the lane phase started) back and the CPU prover finishes, so the
+//! transcript, challenge derivation and proof layout are unchanged.
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, OnceLock};
+
+use akita_error::AkitaError;
+use akita_serialization::{AkitaSerialize, Compress};
+use jolt_field::solinas::parallel::*;
+use jolt_field::{Field, Ring};
+
+/// Canonical little-endian byte length of one field element on the wire.
+pub const FIELD_BYTES: usize = 16;
+/// Round messages: `virt[q0,q1,q2]`, `rel[c0,c1,c2]`, `add[a0,a1,a2,a3]`.
+pub const TERMS: usize = 10;
+pub const MESSAGE_BYTES: usize = TERMS * FIELD_BYTES;
+/// One additional pair on the wire: `[m, 0, 0, 0]` u32 then `l0, l1, b0, b1`.
+pub const PAIR_BYTES: usize = 5 * FIELD_BYTES;
+/// One linear segment on the wire: `[source_lane, source_index, 0, 0]` u32
+/// then `factor`; `lane_map[lane] = start << 8 | count` selects a lane's
+/// segments.
+pub const SEGMENT_BYTES: usize = 2 * FIELD_BYTES;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum WeightsKind {
+    /// `weights` holds `domain_len` flat entries, folded by the device.
+    Dense,
+    /// `alpha[coef] * lane_weights[lane] + segments`; the device folds the
+    /// lane table into a flat table at the first lane round.
+    Factored,
+}
+
+pub struct RelationRangeShape {
+    /// Live witness length `live_lane_count * coeff_count`.
+    pub len: usize,
+    /// Padded relation domain (power of two, `>= len`).
+    pub domain_len: usize,
+    pub coefficient_bits: usize,
+    pub lane_bits: usize,
+    pub bit_width: u8,
+    pub weights: WeightsKind,
+    pub segments: usize,
+}
+
+pub struct RelationRangeJob<'a> {
+    pub shape: RelationRangeShape,
+    /// `len` digits, two's complement at `bit_width` bits each, LSB-first
+    /// contiguous (`PackedSignedDigits`), flat index `lane * coeff_count +
+    /// coefficient`.
+    pub digits: &'a [u8],
+    /// `Dense`: `domain_len` weights (16 B LE each); `Factored`: empty.
+    pub weights: &'a [u8],
+    /// `Factored`: `1 << lane_bits` lane weights; `Dense`: empty.
+    pub lane_weights: &'a [u8],
+    /// `Factored`: `shape.segments` linear segments (`SEGMENT_BYTES` each).
+    pub segments: &'a [u8],
+    /// `Factored`: one word per live lane, `start << 8 | count` into `segments`.
+    pub lane_map: &'a [u32],
+    /// `Factored`: lanes per linear source (source values are
+    /// `lane_count * coeff_count`, lane-major).
+    pub source_lanes: &'a [u32],
+}
+
+pub struct RoundInput<'a> {
+    pub round: usize,
+    /// Challenge that folds the tables before this round's evaluation
+    /// (absent in round 0).
+    pub prev: Option<&'a [u8; FIELD_BYTES]>,
+    pub e_first: &'a [u8],
+    pub e_second: &'a [u8],
+    /// `Factored`, while `round <= coefficient_bits`: the common alpha
+    /// factor folded so far (`coeff_count >> round` entries).
+    pub alpha: &'a [u8],
+    /// `Factored`, while `round <= coefficient_bits`: every linear source
+    /// folded so far, concatenated.
+    pub sources: &'a [u8],
+    /// Additional pairs of this round (`PAIR_BYTES` each; binary weights
+    /// pre-multiplied by the batching coefficient).
+    pub pairs: &'a [u8],
+}
+
+pub trait RelationRangeSession: Send + Sync {
+    fn round(
+        &mut self,
+        input: &RoundInput<'_>,
+        out: &mut [u8; MESSAGE_BYTES],
+    ) -> Result<(), AkitaError>;
+
+    /// `(witness, weights)` as the last round evaluated them (folded by every
+    /// earlier challenge): the witness has `ceil(len / 2^rounds_folded)`
+    /// entries; the weights `domain_len >> rounds_folded` entries for `Dense`
+    /// and for `Factored` once the lane phase started, otherwise empty.
+    fn tables(self: Box<Self>) -> Result<(Vec<u8>, Vec<u8>), AkitaError>;
+}
+
+pub trait RelationRangeDevice: Send + Sync {
+    /// Rounds the device would run on this shape; 0 declines (nothing is
+    /// materialized for declined instances).
+    fn rounds_for(&self, shape: &RelationRangeShape) -> usize;
+
+    fn open(
+        &self,
+        job: &RelationRangeJob<'_>,
+        rounds: usize,
+    ) -> Result<Box<dyn RelationRangeSession>, AkitaError>;
+}
+
+static DEVICE: OnceLock<Arc<dyn RelationRangeDevice>> = OnceLock::new();
+static PARITY_ROUNDS: AtomicUsize = AtomicUsize::new(0);
+
+/// Install the process-wide device; fails if one is already installed.
+pub fn set_relation_range_device(device: Arc<dyn RelationRangeDevice>) -> Result<(), AkitaError> {
+    DEVICE
+        .set(device)
+        .map_err(|_| AkitaError::InvalidSetup("relation-range device already installed".into()))
+}
+
+/// Keep the CPU prover authoritative and check the device's first `rounds`
+/// round polynomials and its handoff tables against it; a mismatch fails the
+/// prove.
+pub fn set_relation_range_parity_rounds(rounds: usize) {
+    PARITY_ROUNDS.store(rounds, Ordering::SeqCst);
+}
+
+pub(super) fn installed_device() -> Option<&'static Arc<dyn RelationRangeDevice>> {
+    DEVICE.get()
+}
+
+pub(super) fn parity_rounds() -> usize {
+    PARITY_ROUNDS.load(Ordering::SeqCst)
+}
+
+pub(super) fn field_to_bytes<E: Field + AkitaSerialize>(value: &E, out: &mut [u8]) {
+    let mut cursor = std::io::Cursor::new(out);
+    value
+        .serialize_with_mode(&mut cursor, Compress::No)
+        .expect("16-byte field element serializes into a 16-byte slot");
+}
+
+pub(super) fn fields_to_bytes<E: Field + AkitaSerialize>(values: &[E]) -> Vec<u8> {
+    let mut out = vec![0u8; values.len() * FIELD_BYTES];
+    cfg_chunks_mut!(out, FIELD_BYTES * 4096)
+        .zip(cfg_chunks!(values, 4096))
+        .for_each(|(chunk, values)| {
+            for (value, slot) in values.iter().zip(chunk.chunks_exact_mut(FIELD_BYTES)) {
+                field_to_bytes(value, slot);
+            }
+        });
+    out
+}
+
+pub(super) fn field_from_bytes<E: Ring>(bytes: &[u8]) -> E {
+    let mut word = [0u8; FIELD_BYTES];
+    word.copy_from_slice(bytes);
+    E::from_u128(u128::from_le_bytes(word))
+}
+
+pub(super) fn fields_from_bytes<E: Ring>(bytes: &[u8]) -> Result<Vec<E>, AkitaError> {
+    if !bytes.len().is_multiple_of(FIELD_BYTES) {
+        return Err(AkitaError::InvalidSize {
+            expected: bytes.len().div_ceil(FIELD_BYTES) * FIELD_BYTES,
+            actual: bytes.len(),
+        });
+    }
+    Ok(bytes
+        .chunks_exact(FIELD_BYTES)
+        .map(field_from_bytes)
+        .collect())
+}
+
+/// Device state of one prover while its rounds run on the device.
+pub(super) struct DeviceRounds<E: Field> {
+    pub(super) session: Option<Box<dyn RelationRangeSession>>,
+    pub(super) rounds: usize,
+    pub(super) prev: Option<E>,
+    /// CPU state stays authoritative; device polynomials and tables are compared.
+    pub(super) parity: bool,
+    pub(super) kind: WeightsKind,
+    pub(super) witness_len: usize,
+    pub(super) domain_len: usize,
+}
diff --git a/crates/akita-prover/src/protocol/sumcheck/relation_range_image/device_flow.rs b/crates/akita-prover/src/protocol/sumcheck/relation_range_image/device_flow.rs
new file mode 100644
index 0000000..ed1c562
--- /dev/null
+++ b/crates/akita-prover/src/protocol/sumcheck/relation_range_image/device_flow.rs
@@ -0,0 +1,410 @@
+use super::device::{
+    field_from_bytes, field_to_bytes, fields_from_bytes, fields_to_bytes, installed_device,
+    parity_rounds, DeviceRounds, RelationRangeJob, RelationRangeShape, RoundInput, WeightsKind,
+    FIELD_BYTES, MESSAGE_BYTES, TERMS,
+};
+use super::*;
+use akita_serialization::{AkitaSerialize, Compress};
+
+/// What `ingest_challenge` does with the CPU state after the device was
+/// consulted.
+pub(super) enum DeviceFold<E: Field> {
+    /// The device owns the tables this round: the CPU fold is skipped.
+    Skip,
+    /// Fold on the CPU; with `Some`, compare the handed-back tables (already
+    /// folded by this challenge) against the CPU state afterwards.
+    Cpu(Option<(Vec<E>, Vec<E>)>),
+}
+
+/// One device round as the host consumes it.
+pub(super) struct DeviceRound<E: Field> {
+    pub(super) virt: NormRoundTerms<E>,
+    pub(super) rel: [E; 3],
+    pub(super) additional: UniPoly<E>,
+}
+
+const MAX_SEGMENTS: usize = 1 << 20;
+
+impl<E: Field + Ring + Unreduced + AkitaSerialize> RelationRangeImageProver<E> {
+    /// Offer the instance to the installed device (called from `new` before
+    /// the two-round prefix is built).
+    pub(super) fn try_open_device(&mut self) {
+        let Some(device) = installed_device() else {
+            return;
+        };
+        if E::zero().serialized_size(Compress::No) != FIELD_BYTES || self.num_vars < 2 {
+            return;
+        }
+        let WitnessState::CompactPrefix(compact) = &self.witness_state else {
+            return;
+        };
+        let (kind, domain_len) = match &self.relation_state {
+            RelationRoundState::ReducedDense { weights } => {
+                (WeightsKind::Dense, weights.evaluations().len())
+            }
+            RelationRoundState::QuotientFactored { weights, .. } => (
+                WeightsKind::Factored,
+                weights.common_alpha_factor().len() * weights.relation_lane_weights().len(),
+            ),
+        };
+        let (lane_map, segments) = match kind {
+            WeightsKind::Factored => match self.linear_terms.export_lane_segments(MAX_SEGMENTS) {
+                Some(s) => s,
+                None => {
+                    tracing::info!("stage2_device_declined_linear_kind");
+                    return;
+                }
+            },
+            WeightsKind::Dense => (Vec::new(), Vec::new()),
+        };
+        let shape = RelationRangeShape {
+            len: compact.len(),
+            domain_len,
+            coefficient_bits: self.coefficient_bits(),
+            lane_bits: self.lane_bits,
+            bit_width: compact.bit_width(),
+            weights: kind,
+            segments: segments.len(),
+        };
+        let rounds = device.rounds_for(&shape).min(self.num_vars - 1);
+        if rounds == 0 {
+            return;
+        }
+        let parity = parity_rounds() > 0;
+        let started = Instant::now();
+        let (weights, lane_weights) = match &self.relation_state {
+            RelationRoundState::ReducedDense { weights: dense } => {
+                let mut flat = dense.evaluations().to_vec();
+                self.linear_terms.add_flat_into(&mut flat);
+                if let Some(additional) = &self.additional_relation_terms {
+                    additional.add_linear_into(&mut flat);
+                }
+                (fields_to_bytes(&flat), Vec::new())
+            }
+            RelationRoundState::QuotientFactored { weights, .. } => {
+                (Vec::new(), fields_to_bytes(weights.relation_lane_weights()))
+            }
+        };
+        let mut segment_bytes = Vec::with_capacity(segments.len() * 32);
+        for (words, factor) in &segments {
+            for w in words {
+                segment_bytes.extend_from_slice(&w.to_le_bytes());
+            }
+            let mut f = [0u8; FIELD_BYTES];
+            field_to_bytes(factor, &mut f);
+            segment_bytes.extend_from_slice(&f);
+        }
+        let source_lanes = self.linear_terms.source_lanes();
+        let weights_ms = started.elapsed().as_secs_f64() * 1e3;
+        let job = RelationRangeJob {
+            shape,
+            digits: compact.encoded_bytes(),
+            weights: &weights,
+            lane_weights: &lane_weights,
+            segments: &segment_bytes,
+            lane_map: &lane_map,
+            source_lanes: &source_lanes,
+        };
+        match device.open(&job, rounds) {
+            Ok(session) => {
+                tracing::info!(
+                    rounds,
+                    parity,
+                    weights_ms,
+                    kind = ?kind,
+                    segments = segments.len(),
+                    "stage2_device_plan"
+                );
+                // The flat table absorbed the additional linear weights; only the
+                // binary part stays sparse. Parity keeps the CPU state intact.
+                if kind == WeightsKind::Dense && !parity {
+                    if let Some(additional) = &mut self.additional_relation_terms {
+                        additional.drop_linear();
+                    }
+                }
+                self.device = Some(DeviceRounds {
+                    session: Some(session),
+                    rounds,
+                    prev: None,
+                    parity,
+                    kind,
+                    witness_len: job.shape.len,
+                    domain_len: job.shape.domain_len,
+                });
+            }
+            Err(e) => self.device_error = Some(e),
+        }
+    }
+
+    /// The device's terms for the current round (`None` when the device is
+    /// not running this round). A device error is recorded and surfaces
+    /// through `take_device_error`; the returned terms are then zero.
+    pub(super) fn device_round(&mut self) -> Option<DeviceRound<E>> {
+        let round = self.rounds_completed;
+        let d = self.device.as_ref()?;
+        if round >= d.rounds {
+            return None;
+        }
+        let factored_phase = d.kind == WeightsKind::Factored && round <= self.coefficient_bits();
+        let can_skip = self.can_skip_norm_linear_coeff();
+        let (e_first, e_second) = self.split_eq.remaining_eq_tables();
+        let e_first = fields_to_bytes(e_first);
+        let e_second = fields_to_bytes(e_second);
+        let (alpha, sources) = if factored_phase {
+            match &self.relation_state {
+                RelationRoundState::QuotientFactored { weights, .. } => (
+                    fields_to_bytes(weights.common_alpha_factor()),
+                    self.linear_terms.source_values_bytes(field_to_bytes),
+                ),
+                RelationRoundState::ReducedDense { .. } => (Vec::new(), Vec::new()),
+            }
+        } else {
+            (Vec::new(), Vec::new())
+        };
+        // A dense flat table already carries the additional linear weights.
+        let binary_only = d.kind == WeightsKind::Dense;
+        let pairs = self
+            .additional_relation_terms
+            .as_ref()
+            .map(|a| a.pairs_bytes(binary_only, field_to_bytes))
+            .unwrap_or_default();
+        let d = self.device.as_mut()?;
+        let prev = d.prev.map(|r| {
+            let mut bytes = [0u8; FIELD_BYTES];
+            field_to_bytes(&r, &mut bytes);
+            bytes
+        });
+        let terms = (|| -> Result<[E; TERMS], AkitaError> {
+            let session = d
+                .session
+                .as_mut()
+                .ok_or_else(|| AkitaError::InvalidSetup("relation-range session closed".into()))?;
+            let input = RoundInput {
+                round,
+                prev: prev.as_ref(),
+                e_first: &e_first,
+                e_second: &e_second,
+                alpha: &alpha,
+                sources: &sources,
+                pairs: &pairs,
+            };
+            let mut out = [0u8; MESSAGE_BYTES];
+            session.round(&input, &mut out)?;
+            let mut terms = [E::zero(); TERMS];
+            for (term, bytes) in terms.iter_mut().zip(out.chunks_exact(FIELD_BYTES)) {
+                *term = field_from_bytes(bytes);
+            }
+            Ok(terms)
+        })();
+        let terms = match terms {
+            Ok(terms) => terms,
+            Err(e) => {
+                self.device_error.get_or_insert(e);
+                [E::zero(); TERMS]
+            }
+        };
+        let virt = if can_skip {
+            NormRoundTerms::SkipLinear([terms[0], terms[2]])
+        } else {
+            NormRoundTerms::Full([terms[0], terms[1], terms[2]])
+        };
+        let mut additional = terms[6..10].to_vec();
+        trim_trailing_zeros(&mut additional);
+        Some(DeviceRound {
+            virt,
+            rel: [terms[3], terms[4], terms[5]],
+            additional: UniPoly::from_coeffs(additional),
+        })
+    }
+}
+
+impl<E: Field + Ring + Unreduced + Fold> RelationRangeImageProver<E> {
+    /// The first device error, if any: trait methods cannot fail, so the seam
+    /// records the error, keeps the rounds flowing and surfaces it here.
+    pub fn take_device_error(&mut self) -> Result<(), AkitaError> {
+        match self.device_error.take() {
+            Some(e) => Err(e),
+            None => Ok(()),
+        }
+    }
+
+    /// Record challenge `r` for the device and fold the host-side pieces it
+    /// does not own (Gruen tables, the factored alpha / linear sources in
+    /// coefficient rounds, the live lane count, the sparse additional
+    /// terms). On the device's last round take the tables back (folded by
+    /// `r` here) and, unless parity keeps the CPU authoritative, resume the
+    /// CPU prover from them.
+    pub(super) fn device_ingest(&mut self, r: E) -> DeviceFold<E> {
+        let Some(d) = self.device.as_ref() else {
+            return DeviceFold::Cpu(None);
+        };
+        let round = self.rounds_completed;
+        if round >= d.rounds {
+            return DeviceFold::Cpu(None);
+        }
+        let (parity, kind, rounds, witness_len, domain_len) =
+            (d.parity, d.kind, d.rounds, d.witness_len, d.domain_len);
+        let last = round + 1 == rounds;
+        if parity {
+            if !last {
+                if let Some(d) = self.device.as_mut() {
+                    d.prev = Some(r);
+                }
+                return DeviceFold::Cpu(None);
+            }
+            return match self.device_take_tables(r, witness_len, domain_len, rounds) {
+                Some(tables) => DeviceFold::Cpu(Some(tables)),
+                None => DeviceFold::Cpu(None),
+            };
+        }
+        self.split_eq.bind(r);
+        let in_coefficient_round = self.in_coefficient_round();
+        if let Some(additional) = &mut self.additional_relation_terms {
+            additional.bind(r);
+        }
+        if kind == WeightsKind::Factored && in_coefficient_round {
+            if let RelationRoundState::QuotientFactored { weights, .. } = &mut self.relation_state {
+                fold_evals_in_place(weights.components_mut().0, r);
+            }
+            self.linear_terms.fold_coefficients(r);
+        }
+        if !in_coefficient_round {
+            self.live_lane_count = self.live_lane_count.div_ceil(2);
+        }
+        if !last {
+            if let Some(d) = self.device.as_mut() {
+                d.prev = Some(r);
+            }
+            return DeviceFold::Skip;
+        }
+        let Some((witness, weights)) = self.device_take_tables(r, witness_len, domain_len, rounds)
+        else {
+            return DeviceFold::Skip;
+        };
+        self.witness_state = WitnessState::FoldedSuffix(witness);
+        if !weights.is_empty() {
+            let live_len = witness_len.div_ceil(1 << rounds);
+            match DenseRelationWeights::new(weights, live_len) {
+                Ok(dense) => {
+                    self.relation_state = RelationRoundState::ReducedDense { weights: dense };
+                }
+                Err(e) => {
+                    self.device_error.get_or_insert(e);
+                    return DeviceFold::Skip;
+                }
+            }
+            let coeff_count = 1usize << self.coefficient_bits().saturating_sub(rounds);
+            self.linear_terms = PreparedProverLinearTerms::zero(self.live_lane_count, coeff_count);
+        }
+        DeviceFold::Skip
+    }
+
+    /// Take the device's tables after its last round and fold them by `r`;
+    /// records a device error and returns `None` when they are malformed.
+    fn device_take_tables(
+        &mut self,
+        r: E,
+        witness_len: usize,
+        domain_len: usize,
+        rounds: usize,
+    ) -> Option<(Vec<E>, Vec<E>)> {
+        let d = self.device.take()?;
+        let tables = d
+            .session
+            .ok_or_else(|| AkitaError::InvalidSetup("relation-range session closed".into()))
+            .and_then(|session| session.tables())
+            .and_then(|(w, p)| Ok((fields_from_bytes::<E>(&w)?, fields_from_bytes::<E>(&p)?)));
+        let (mut witness, mut weights) = match tables {
+            Ok(tables) => tables,
+            Err(e) => {
+                self.device_error.get_or_insert(e);
+                return None;
+            }
+        };
+        let expected_witness = witness_len.div_ceil(1 << (rounds - 1));
+        let expected_weights = domain_len >> (rounds - 1);
+        let lane_phase = rounds > self.coefficient_bits();
+        let weights_ok = match d.kind {
+            WeightsKind::Dense => weights.len() == expected_weights,
+            WeightsKind::Factored => weights.len() == if lane_phase { expected_weights } else { 0 },
+        };
+        if witness.len() != expected_witness || !weights_ok {
+            self.device_error.get_or_insert(AkitaError::InvalidSize {
+                expected: expected_witness + expected_weights,
+                actual: witness.len() + weights.len(),
+            });
+            return None;
+        }
+        fold_evals_in_place(&mut witness, r);
+        if !weights.is_empty() {
+            fold_evals_in_place(&mut weights, r);
+        }
+        Some((witness, weights))
+    }
+}
+
+impl<E: Field + Ring + Unreduced> RelationRangeImageProver<E> {
+    /// Parity mode: the handed-back tables must equal the CPU state.
+    pub(super) fn check_device_tables(&mut self, witness: &[E], weights: &[E]) {
+        let cpu_witness = match &self.witness_state {
+            WitnessState::FoldedSuffix(w) => w.as_slice(),
+            WitnessState::CompactPrefix(_) => &[],
+        };
+        let mut cpu_weights = match &self.relation_state {
+            RelationRoundState::ReducedDense { weights } => weights.evaluations().to_vec(),
+            RelationRoundState::QuotientFactored { weights, .. } => {
+                if weights.common_alpha_factor().len() == 1 {
+                    let alpha = weights.common_alpha_factor()[0];
+                    weights
+                        .relation_lane_weights()
+                        .iter()
+                        .map(|lane| alpha * *lane)
+                        .collect()
+                } else {
+                    Vec::new()
+                }
+            }
+        };
+        if !weights.is_empty() {
+            self.linear_terms.add_flat_into(&mut cpu_weights);
+            if matches!(self.relation_state, RelationRoundState::ReducedDense { .. }) {
+                if let Some(additional) = &self.additional_relation_terms {
+                    additional.add_linear_into(&mut cpu_weights);
+                }
+            }
+        }
+        if cpu_witness != witness || (!weights.is_empty() && cpu_weights != weights) {
+            self.device_error.get_or_insert(AkitaError::InvalidSetup(format!(
+                "relation-range device handoff mismatch after round {} (witness {} vs {}, weights {} vs {})",
+                self.rounds_completed,
+                witness.len(),
+                cpu_witness.len(),
+                weights.len(),
+                cpu_weights.len()
+            )));
+        } else {
+            tracing::info!(round = self.rounds_completed, "stage2_device_tables_ok");
+        }
+    }
+
+    /// Parity mode: the device's round polynomial must equal the CPU's.
+    pub(super) fn check_device_poly(&mut self, cpu: &UniPoly<E>) {
+        let Some(dev) = self.device_parity_poly.take() else {
+            return;
+        };
+        if self.rounds_completed >= parity_rounds() {
+            return;
+        }
+        if dev == *cpu {
+            tracing::info!(round = self.rounds_completed, "stage2_device_parity_ok");
+        } else {
+            self.device_error.get_or_insert(AkitaError::InvalidSetup(format!(
+                "relation-range device parity mismatch at round {} (num_vars {}, cpu degree {}, device degree {})",
+                self.rounds_completed,
+                self.num_vars,
+                cpu.coeffs.len(),
+                dev.coeffs.len()
+            )));
+        }
+    }
+}
