+            PreparedLaneWeights::Packing(_) => "packing",
+            PreparedLaneWeights::Dense(_) => "dense",
+        };
+        let values = self.sources.iter().map(|s| s.values.len()).sum();
+        (kind, self.sources.len(), values)
+    }
