+    /// Resume from a materialized table after `rounds_completed` rounds in
+    /// the low-variable phase (`rounds_completed <= ring_bits`); `split_eq`
+    /// must already be bound to those challenges.
+    pub(crate) fn from_materialized(
+        range_image: Vec<E>,
+        split_eq: GruenSplitEq<E>,
+        basis: usize,
+        live_x_cols: usize,
+        col_bits: usize,
+        ring_bits: usize,
+        rounds_completed: usize,
+    ) -> Self {
+        debug_assert!(rounds_completed <= ring_bits);
+        debug_assert_eq!(
+            range_image.len(),
+            (live_x_cols << ring_bits) >> rounds_completed
+        );
+        Self {
+            range_image: LowBasisRangeImageStorage::Materialized(range_image),
+            split_eq,
+            polynomial_precomputation: RangePolynomialPrecomputation::new(basis),
+            live_x_cols,
+            col_bits,
+            num_vars: col_bits + ring_bits,
+            basis,
+            prefix_tau: None,
+            initial_round_prefix: None,
+            cached_round_poly: None,
+            rounds_completed,
+        }
+    }
+
     /// Return `range_image(stage1_point)` after the final fold.
