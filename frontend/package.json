{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "cd .. && oxlint --type-aware --tsconfig tsconfig.json -c .oxlintrc.json .",
    "preview": "vite preview",
    "lint:types": "tsc -p ../tsconfig.json && tsc -b",
    "lint:knip": "cd .. && frontend/node_modules/.bin/knip",
    "lint:css": "stylelint --config stylelint.config.mjs src/index.css",
    "lint:html": "html-validate --config ../.htmlvalidate.json index.html ../bench/proto/harness.html ../bench/proto-w2/harness.html"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "0.1.74",
    "html-validate": "11.17.0",
    "knip": "6.44.1",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "shadcn": "4.23.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-order": "8.1.2",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
